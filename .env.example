# crate environment reference. Copy the relevant block into api/.env or
# web/.env.local — this file is documentation, never loaded directly.

# ── api (api/.env) ──────────────────────────────────────────────────────────
# Environment name: local | production
APP_ENV=local
# Sync-driver MySQL URL. Matches the compose service (host port 3308).
DATABASE_URL=mysql+pymysql://crate:crate@127.0.0.1:3308/crate
# JSON list of browser origins allowed by CORS. Defaults cover local web dev
# plus Vercel placeholders; override with the real Vercel domains on Railway.
CORS_ORIGINS=["http://localhost:3200","https://crate.vercel.app"]

# ── web (web/.env.local) ────────────────────────────────────────────────────
# Base URL of the crate API. Local dev default; set to the Railway URL on Vercel.
NEXT_PUBLIC_CRATE_API_URL=http://localhost:8200
