# crate environment reference. Copy the relevant block into api/.env or
# web/.env.local — this file is documentation, never loaded directly.
# Every variable the app reads is listed. Vars with a working default are
# commented out ("optional") and can be omitted for local dev.

# ═══ api (api/.env) ══════════════════════════════════════════════════════════

# ── Required to connect a Spotify account ──
# Spotify app client id (create one at developer.spotify.com). No client
# *secret* needed — crate uses the PKCE loopback flow.
SPOTIFY_CLIENT_ID=your_spotify_client_id
# Must exactly match a Redirect URI registered on that Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8200/v1/auth/spotify/callback

# ── Core ──
APP_ENV=local
# Sync-driver MySQL URL. Matches the compose service (host port 3308).
DATABASE_URL=mysql+pymysql://crate:crate@127.0.0.1:3308/crate
# JSON list of browser origins allowed by CORS.
CORS_ORIGINS=["http://localhost:3200","http://127.0.0.1:3200"]
# Where OAuth redirects the browser back to after connecting.
WEB_APP_URL=http://localhost:3200

# ── Auth (pick dev bypass OR Clerk) ──
# Dev bypass: attribute every request to this user (created on first use),
# skipping Clerk. Leave unset to require Clerk JWTs instead.
CRATE_DEV_USER=jt-dev
# Fernet key encrypting stored Spotify tokens. A dev default ships in code, so
# local dev works unset; deployments MUST set their own. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRATE_ENCRYPTION_KEY=

# ── Optional enrichment API keys (source is skipped if unset) ──
# LASTFM_API_KEY=
# FREQBLOG_API_KEY=
# FREQBLOG_MONTHLY_BUDGET=1000

# ── Optional write / analysis toggles (defaults shown) ──
# Skip real Spotify writes — mutations stay local + journaled. Dev only.
# CRATE_FAKE_SPOTIFY=false
# Analyze 30s Deezer previews locally when hosted feature sources miss a track.
# CRATE_LOCALDSP_ENABLED=true
# LOCALDSP_CACHE_DIR=           # empty -> <tmp>/crate-previews
# LOCALDSP_CACHE_MAX_MB=200
# Prefer /playlists/{id}/items over the deprecated /tracks alias.
# SPOTIFY_USE_ITEMS_ENDPOINTS=true

# ── Optional scheduler + backup (defaults shown; all times UTC) ──
# CRATE_SCHEDULER_ENABLED=true
# RECENT_PLAYS_INTERVAL_MINUTES=30
# NIGHTLY_SYNC_HOUR=3
# TOP_ITEMS_DAY_OF_MONTH=1
# TOP_ITEMS_HOUR=4
# DIGEST_WEEKDAY=0              # 0 = Monday
# DIGEST_HOUR=5
# CRATE_BACKUP_ENABLED=true
# BACKUP_HOUR=2
# BACKUP_MINUTE=30
# CRATE_BACKUP_DIR=            # empty -> backups/crate
# CRATE_TOKEN_SPILL_PATH=     # empty -> api/data/token_spill

# ═══ web (web/.env.local) ════════════════════════════════════════════════════

# Base URL of the crate API.
NEXT_PUBLIC_CRATE_API_URL=http://localhost:8200
# Auth mode: "dev" (no Clerk; pairs with CRATE_DEV_USER on the API) or unset for Clerk.
NEXT_PUBLIC_CRATE_AUTH=dev
# Dev-auth user shown in the web UI (match CRATE_DEV_USER above).
NEXT_PUBLIC_CRATE_DEV_USER=jt-dev

# ── Clerk mode (only when NEXT_PUBLIC_CRATE_AUTH is unset) ──
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Optional web toggles ──
# NEXT_PUBLIC_CRATE_PLAYBACK=        # in-app preview playback
# NEXT_PUBLIC_CRATE_GRAPH_FIXTURE=   # load a static graph fixture instead of live data
